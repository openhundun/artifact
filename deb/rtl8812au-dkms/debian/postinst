#!/bin/sh
set -e

case "${1}" in
configure)
    if dkms status 2> /dev/null | grep -q "^rtl8812au/"; then
        dkms remove -m rtl8812au -v 5.6.4.2 --all > /dev/null 2>&1 || true
    fi
    dkms add -m rtl8812au -v 5.6.4.2 > /dev/null 2>&1 || true
    OK="0"
    for d in /lib/modules/*/build; do
        [ -d "${d}" ] || continue
        k="$(basename "$(dirname "${d}")")"
        if dkms build -m rtl8812au -v 5.6.4.2 -k "${k}" > /dev/null 2>&1 && dkms install -m rtl8812au -v 5.6.4.2 -k "${k}" > /dev/null 2>&1; then
            OK="$((OK + 1))"
        fi
    done
    depmod -a > /dev/null 2>&1 || true
    if [ "${OK}" -gt 0 ]; then
        echo "rtl8812au-dkms: module built and installed for ${OK} kernel(s), $(uname -r) running"
    else
        echo "rtl8812au-dkms: dkms build skipped (linux-headers missing? will auto-build on next kernel install)." >&2
    fi
    ;;
esac
exit 0
