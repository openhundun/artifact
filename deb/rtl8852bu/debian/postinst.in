#!/bin/sh
set -e

case "${1}" in
configure)
    if dkms status 2> /dev/null | grep -q "^@MODULE@/"; then
        dkms remove -m @MODULE@ -v @VER@ --all > /dev/null 2>&1 || true
    fi
    dkms add -m @MODULE@ -v @VER@ > /dev/null 2>&1 || true
    OK="0"
    for d in /lib/modules/*/build; do
        [ -d "${d}" ] || continue
        k="$(basename "$(dirname "${d}")")"
        if dkms build -m @MODULE@ -v @VER@ -k "${k}" > /dev/null 2>&1 && dkms install -m @MODULE@ -v @VER@ -k "${k}" > /dev/null 2>&1; then
            OK="$((OK + 1))"
        fi
    done
    depmod -a > /dev/null 2>&1 || true
    if [ "${OK}" -gt 0 ]; then
        echo "@PKG@: module built and installed for ${OK} kernel(s), $(uname -r) running"
    else
        echo "@PKG@: dkms build skipped (linux-headers missing? will auto-build on next kernel install)." >&2
    fi
    ;;
esac
exit 0
